# ==============================================================================
# Email Scheduler Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
# Local: postgresql://postgres:postgres@localhost:5432/email_scheduler?schema=public
# Production (Neon/Supabase): postgresql://user:password@ep-xyz.region.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_scheduler?schema=public

# Redis (BullMQ & Rate Limiting)
# Local: redis://localhost:6379
# Production (Upstash): rediss://default:password@xyz.upstash.io:6379
REDIS_URL=redis://localhost:6379

# Elasticsearch
# Local: http://localhost:9200
# Production (Bonsai/Elastic Cloud): https://xyz.bonsaisearch.net:443
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=emails
# Optional if using Elastic Cloud / Basic Auth:
# ELASTICSEARCH_USERNAME=
# ELASTICSEARCH_PASSWORD=
# ELASTICSEARCH_API_KEY=

# Google OAuth 2.0
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Slack OAuth 2.0 (Optional integration for rate-limit alerts)
# Obtain from https://api.slack.com/apps -> OAuth & Permissions
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:4000/auth/slack/callback

# Session & Security
# Generate with: openssl rand -hex 32
SESSION_SECRET=super_secret_session_encryption_key_at_least_32_chars
# Set COOKIE_SECURE=true and COOKIE_SAME_SITE=none in production when frontend & API are on different domains
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Bull Board Dashboard Security
BULL_BOARD_USER=admin
BULL_BOARD_PASS=admin_secure_password_123

# Queue & Rate Limiting Parameters (Non-hardcoded)
MAX_EMAILS_PER_HOUR=100
MAX_EMAILS_PER_HOUR_PER_SENDER=20
WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000

# Next.js Public Environment Variable
NEXT_PUBLIC_API_URL=http://localhost:4000
